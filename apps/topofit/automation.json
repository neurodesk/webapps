{
  "schemaVersion": 2,
  "app": "topofit",
  "title": "TopoFit",
  "description": "TopoFit scientific workflow automation.",
  "defaultOperation": "reconstruct",
  "operations": {
    "reconstruct": {
      "title": "Reconstruct cortical surfaces",
      "description": "Reconstruct cortical surfaces. Uses the same scientific processing handler as the interface.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "description": "Input image for processing",
          "minimum": 1,
          "maximum": 1
        },
        "roi": {
          "source": "files",
          "type": "neuro:mask",
          "formats": [
            "nifti",
            "dicom"
          ],
          "description": "Optional binary ROI in the input image grid",
          "minimum": 0,
          "maximum": 1
        }
      },
      "parameters": {
        "model": {
          "type": "string",
          "default": "t1w-1mm",
          "enum": [
            "t1w-1mm"
          ],
          "description": "Published model variant"
        },
        "conform": {
          "type": "boolean",
          "default": true,
          "description": "Conform to the model 1 mm RAS grid"
        },
        "parallelHemispheres": {
          "type": "boolean",
          "description": "Reconstruct both hemispheres at once; uses about 3 GB more memory. Omit to keep the app's setting, which is off below 8 GB and after a crashed parallel run"
        },
        "thickness": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "QC overlay thickness setting"
        },
        "estimateNormals": {
          "type": "boolean",
          "default": false,
          "description": "Export mid-surface vertex normals"
        },
        "findPatches": {
          "type": "boolean",
          "default": false,
          "description": "Find flat cortical patches"
        },
        "patchCount": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum patches per hemisphere"
        },
        "patchRadius": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 20,
          "description": "Patch radius in millimetres"
        },
        "patchHemisphere": {
          "type": "string",
          "default": "both",
          "enum": [
            "both",
            "lh",
            "rh"
          ],
          "description": "Hemisphere to search for patches"
        },
        "patchRegion": {
          "type": "string",
          "default": "cortex",
          "enum": [
            "cortex",
            "wang2015:visual",
            "wang2015:V1",
            "wang2015:V2",
            "wang2015:V3",
            "wang2015:hV4",
            "wang2015:VO1",
            "wang2015:VO2",
            "wang2015:PHC1",
            "wang2015:PHC2",
            "wang2015:TO1",
            "wang2015:TO2",
            "wang2015:LO1",
            "wang2015:LO2",
            "wang2015:V3A",
            "wang2015:V3B",
            "wang2015:IPS0",
            "wang2015:IPS1",
            "wang2015:IPS2",
            "wang2015:IPS3",
            "wang2015:IPS4",
            "wang2015:IPS5",
            "wang2015:SPL1",
            "wang2015:FEF",
            "wang2015:V1v",
            "wang2015:V1d",
            "wang2015:V2v",
            "wang2015:V2d",
            "wang2015:V3v",
            "wang2015:V3d",
            "aparc:lobe-frontal",
            "aparc:lobe-parietal",
            "aparc:lobe-temporal",
            "aparc:lobe-occipital",
            "aparc:lobe-cingulate",
            "aparc:lobe-insula",
            "aparc:bankssts",
            "aparc:caudalanteriorcingulate",
            "aparc:caudalmiddlefrontal",
            "aparc:cuneus",
            "aparc:entorhinal",
            "aparc:frontalpole",
            "aparc:fusiform",
            "aparc:inferiorparietal",
            "aparc:inferiortemporal",
            "aparc:insula",
            "aparc:isthmuscingulate",
            "aparc:lateraloccipital",
            "aparc:lateralorbitofrontal",
            "aparc:lingual",
            "aparc:medialorbitofrontal",
            "aparc:middletemporal",
            "aparc:paracentral",
            "aparc:parahippocampal",
            "aparc:parsopercularis",
            "aparc:parsorbitalis",
            "aparc:parstriangularis",
            "aparc:pericalcarine",
            "aparc:postcentral",
            "aparc:posteriorcingulate",
            "aparc:precentral",
            "aparc:precuneus",
            "aparc:rostralanteriorcingulate",
            "aparc:rostralmiddlefrontal",
            "aparc:superiorfrontal",
            "aparc:superiorparietal",
            "aparc:superiortemporal",
            "aparc:supramarginal",
            "aparc:temporalpole",
            "aparc:transversetemporal"
          ],
          "description": "Search region: the whole eligible cortex or a named atlas region (Wang 2015 visual areas, Desikan-Killiany); not with an ROI"
        },
        "patchMaxRms": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.01,
          "maximum": 2,
          "description": "Maximum patch plane RMS error in millimetres"
        },
        "patchMinArea": {
          "type": "number",
          "default": 0.25,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Minimum fraction of nominal patch area"
        }
      },
      "artifacts": {
        "surface": {
          "type": "neuro:surface",
          "mediaType": "application/vnd.freesurfer.surface",
          "minimum": 6,
          "space": "scanner-RAS-mm"
        },
        "qc": {
          "type": "neuro:label-map",
          "mediaType": "application/nifti",
          "minimum": 1,
          "space": "input",
          "maximum": 2
        },
        "table": {
          "type": "neuro:table",
          "mediaType": "text/csv",
          "minimum": 0,
          "maximum": 3
        },
        "metadata": {
          "type": "neuro:metadata",
          "mediaType": "application/json",
          "minimum": 1,
          "maximum": 3
        },
        "registration": {
          "type": "neuro:surface",
          "mediaType": "application/vnd.freesurfer.surface",
          "space": "registration-sphere",
          "minimum": 2,
          "maximum": 2
        },
        "parcellation": {
          "type": "neuro:surface-regions",
          "mediaType": "application/vnd.freesurfer.annotation",
          "minimum": 0,
          "maximum": 2
        },
        "region-mask": {
          "type": "neuro:label-map",
          "mediaType": "application/nifti",
          "space": "input",
          "minimum": 0,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
