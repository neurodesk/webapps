{
  "name": "musclemap",
  "version": "1.4.20260920",
  "releaseSeries": "1.4",
  "private": true,
  "type": "module",
  "description": "MuscleMap — in-browser muscle segmentation and fat metrics.",
  "scripts": {
    "models:generate": "node scripts/generate_model_contracts.mjs",
    "models:check": "node scripts/generate_model_contracts.mjs --check",
    "model:env": "bash scripts/setup_conversion_env.sh",
    "model:convert": "bash scripts/convert_all_models.sh",
    "model:validate": ".tmp_model_env/bin/python scripts/validate_model_fidelity.py",
    "model:validate-browser": "node scripts/validate_browser_model.mjs",
    "model:validate-preprocessing": "node scripts/validate_preprocessing_parity.mjs",
    "model:validate-upstream": "node scripts/validate_upstream_parity.mjs",
    "model:publish": ".tmp_model_env/bin/python scripts/publish_model.py",
    "model:activate": ".tmp_model_env/bin/python scripts/activate_model_release.py",
    "vendor": "node ../../scripts/vendor-components.mjs",
    "runtime-support": "node ../../scripts/vendor-runtime-support.mjs",
    "predev": "pnpm vendor && pnpm runtime-support",
    "dev": "node ../../scripts/dev-server.mjs --dir web --port 8080 --cache-policy 'no-store, max-age=0'",
    "prebuild": "pnpm models:check && pnpm vendor && pnpm runtime-support && node ../../scripts/fetch-app-runtime.mjs --dest web/wasm ort-web:ort.webgpu.bundle.min.mjs,ort.webgpu.min.js,ort-wasm-simd-threaded.mjs,ort-wasm-simd-threaded.wasm,ort-wasm-simd-threaded.jsep.mjs,ort-wasm-simd-threaded.jsep.wasm && node scripts/prepare_model_assets.mjs",
    "build": "node ../../scripts/build-static.mjs",
    "pretest": "pnpm models:check && pnpm runtime-support",
    "pretest:e2e": "pnpm vendor && pnpm runtime-support && bash web/setup.sh",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:python": "python3 -m pytest tests/ -q",
    "test:examples": "node --test scripts/test_examples.mjs"
  },
  "dependencies": {
    "@neurodesk/webapp-components": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "jsdom": "^24.0.0"
  },
  "neurodeskWebapp": {
    "static": {
      "coiServiceWorker": true
    }
  }
}
