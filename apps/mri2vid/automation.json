{
  "schemaVersion": 2,
  "app": "mri2vid",
  "title": "MRI2VID",
  "description": "Create a video from NIfTI, MGZ or explicitly selected DICOM series.",
  "defaultOperation": "encode-volume",
  "operations": {
    "encode-volume": {
      "title": "Encode video",
      "description": "Read the selected volume and encode its slices with the application encoder.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "mgh",
            "mgz"
          ],
          "description": "Input volume.",
          "minimum": 1,
          "maximum": 1
        }
      },
      "parameters": {
        "orientation": {
          "type": "string",
          "enum": [
            "axial",
            "coronal",
            "sagittal",
            "axial_flipped",
            "coronal_flipped",
            "sagittal_flipped"
          ],
          "default": "sagittal",
          "description": "Slice orientation."
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 20,
          "description": "Frames per second."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "First slice index (zero-based)."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Exclusive end slice index (zero-based)."
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Slice step."
        },
        "annotate": {
          "type": "boolean",
          "default": false,
          "description": "Add slice position labels."
        },
        "format": {
          "type": "string",
          "enum": [
            "webm",
            "mp4"
          ],
          "default": "webm",
          "description": "Output video container."
        },
        "colorNormalize": {
          "type": "boolean",
          "default": false,
          "description": "Normalize RGB channels."
        },
        "upscale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 1,
          "description": "Output spatial scale."
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "nearest",
            "bilinear"
          ],
          "default": "bilinear",
          "description": "Resampling interpolation."
        }
      },
      "artifacts": {
        "video": {
          "type": "file:video",
          "mediaType": "application/octet-stream",
          "minimum": 1,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    },
    "encode-dicom": {
      "title": "Encode video",
      "description": "Read the selected volume and encode its slices with the application encoder.",
      "mode": "batch",
      "inputs": {
        "series": {
          "source": "files",
          "type": "neuro:dicom-series",
          "formats": [
            "dicom"
          ],
          "description": "DICOM series files or directory.",
          "minimum": 1
        }
      },
      "parameters": {
        "orientation": {
          "type": "string",
          "enum": [
            "axial",
            "coronal",
            "sagittal",
            "axial_flipped",
            "coronal_flipped",
            "sagittal_flipped"
          ],
          "default": "sagittal",
          "description": "Slice orientation."
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 20,
          "description": "Frames per second."
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "First slice index (zero-based)."
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "description": "Exclusive end slice index (zero-based)."
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Slice step."
        },
        "annotate": {
          "type": "boolean",
          "default": false,
          "description": "Add slice position labels."
        },
        "format": {
          "type": "string",
          "enum": [
            "webm",
            "mp4"
          ],
          "default": "webm",
          "description": "Output video container."
        },
        "colorNormalize": {
          "type": "boolean",
          "default": false,
          "description": "Normalize RGB channels."
        },
        "upscale": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 1,
          "description": "Output spatial scale."
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "nearest",
            "bilinear"
          ],
          "default": "bilinear",
          "description": "Resampling interpolation."
        },
        "seriesUid": {
          "type": "string",
          "description": "Explicit SeriesInstanceUID; required when the input contains multiple series."
        },
        "mosaicReduce": {
          "type": "string",
          "enum": [
            "mean",
            "first"
          ],
          "default": "first",
          "description": "Collapse a Siemens mosaic time series."
        }
      },
      "artifacts": {
        "video": {
          "type": "file:video",
          "mediaType": "application/octet-stream",
          "minimum": 1,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
