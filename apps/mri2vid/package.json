{
  "name": "mri2vid",
  "version": "0.6.20261027",
  "private": true,
  "type": "module",
  "description": "Client-side, in-browser DICOM/NIfTI/MGZ to video tool",
  "scripts": {
    "dev": "python3 -m http.server 8000 --directory web",
    "vendor": "node ../../scripts/vendor-components.mjs && node ../../packages/mri2vid/scripts/stage-browser.mjs",
    "prebuild": "node ../../packages/mri2vid/scripts/stage-browser.mjs",
    "build": "node ../../scripts/build-static.mjs",
    "lint": "node ../../scripts/check-app-js.mjs web",
    "pretest": "bash tools/generate_test_fixtures.sh",
    "test": "node --test tools/test/*.test.mjs",
    "pretest:e2e": "pnpm vendor && bash tools/generate_test_fixtures.sh",
    "test:e2e": "node tools/browser/smoke.mjs && playwright test",
    "serve": "python3 -m http.server 8000 --directory web",
    "test:examples": "node --test tools/test/examples.test.mjs",
    "predev": "pnpm vendor"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@neurodesk/mri2vid": "workspace:*",
    "@neurodesk/webapp-components": "workspace:*"
  }
}
