{
  "schemaVersion": 2,
  "app": "sdc",
  "title": "SDC",
  "description": "Susceptibility field from a reverse phase-encoding b = 0 pair (PyHySCO 0.0.4 port).",
  "defaultOperation": "pyhysco",
  "operations": {
    "pyhysco": {
      "title": "Estimate field",
      "description": "Average each input's b = 0 volumes and estimate the field in Hz on the first image's grid.",
      "mode": "batch",
      "inputs": {
        "image1": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "minimum": 1,
          "maximum": 1,
          "description": "Image 1 of the opposite phase-encoding pair; image 1 defines the field reference"
        },
        "sidecar1": {
          "source": "files",
          "type": "neuro:metadata",
          "formats": [
            "json"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Acquisition JSON for image 1; required unless DICOM supplies it"
        },
        "bval1": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bval",
            "bvals"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Optional b-values for image 1; average only b \u2264 50 volumes"
        },
        "image2": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "minimum": 1,
          "maximum": 1,
          "description": "Image 2 of the opposite phase-encoding pair; image 1 defines the field reference"
        },
        "sidecar2": {
          "source": "files",
          "type": "neuro:metadata",
          "formats": [
            "json"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Acquisition JSON for image 2; required unless DICOM supplies it"
        },
        "bval2": {
          "source": "files",
          "type": "neuro:gradients",
          "formats": [
            "bval",
            "bvals"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Optional b-values for image 2; average only b \u2264 50 volumes"
        }
      },
      "parameters": {},
      "artifacts": {
        "field": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "space": "input",
          "minimum": 1,
          "maximum": 1
        },
        "sidecar": {
          "type": "neuro:metadata",
          "mediaType": "application/json",
          "minimum": 1,
          "maximum": 1
        },
        "corrected1": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "space": "input",
          "minimum": 1,
          "maximum": 1
        },
        "corrected2": {
          "type": "neuro:volume",
          "mediaType": "application/gzip",
          "space": "input",
          "minimum": 1,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
