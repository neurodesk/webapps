{
  "name": "greedy",
  "version": "0.1.20260911",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @neurodesk/greedy build:wasm && node scripts/copy-runtime.mjs && vite --force",
    "build": "pnpm --filter @neurodesk/greedy build:wasm && node scripts/copy-runtime.mjs && vite build && node ../../scripts/theme-app-dist.mjs --app greedy",
    "preview": "vite preview",
    "test": "node --test test/*.test.js ../../packages/greedy/test/*.test.js && cargo test --manifest-path ../../exes/greedy/Cargo.toml --workspace --locked",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@brainchop/mindgrab": "0.1.20260813",
    "@neurodesk/greedy": "workspace:*",
    "@neurodesk/runtime-support": "workspace:*",
    "@neurodesk/webapp-components": "workspace:*",
    "@niivue/niivue": "1.0.0-rc.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^9.0.0",
    "vite": "^5.0.0"
  },
  "neurodeskWebapp": {
    "coiServiceWorker": true
  }
}
