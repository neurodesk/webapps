{
  "name": "deface",
  "private": true,
  "version": "1.4.20261023",
  "type": "module",
  "license": "BSD-2-Clause",
  "description": "Remove facial features from brain MRI for anonymization, entirely in the browser. No data leaves your machine. Uses niimath (BSD affine defacing, fast engine) + NiiVue.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../../scripts/theme-app-dist.mjs --app deface",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit",
    "test:e2e": "node ../../test-utils/run-browser-tests.mjs \"node test/smoke.mjs && playwright test\""
  },
  "dependencies": {
    "@neurodesk/deface": "workspace:*",
    "@neurodesk/runtime-support": "workspace:*",
    "@neurodesk/webapp-components": "workspace:*",
    "@niivue/niivue": "1.0.0-rc.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@webgpu/types": "^0.1.52",
    "playwright": "^1.57.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
