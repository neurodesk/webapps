{
  "schemaVersion": 2,
  "app": "seedseg",
  "title": "SeedSeg",
  "description": "Segment prostate fiducial markers with nnU-Net v2 or legacy v1.",
  "defaultOperation": "segment",
  "operations": {
    "segment": {
      "title": "Segment fiducial markers",
      "description": "Run bias correction, selected ONNX models, probability averaging and marker selection.",
      "mode": "batch",
      "inputs": {
        "image": {
          "source": "files",
          "type": "neuro:volume",
          "formats": [
            "nifti",
            "dicom"
          ],
          "description": "T1-weighted prostate MRI containing fiducial markers",
          "space": "native",
          "minimum": 1,
          "maximum": 1
        }
      },
      "parameters": {
        "pipeline": {
          "type": "string",
          "description": "Scientific pipeline (defaults to v2, or legacy v1 when models is supplied)",
          "enum": [
            "nnunet-v2",
            "legacy-v1"
          ]
        },
        "folds": {
          "type": "array",
          "description": "Distinct nnU-Net v2 folds in published order",
          "items": {
            "type": "integer",
            "description": "Cross-validation fold",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "mirror": {
          "type": "boolean",
          "description": "Average all eight mirrored predictions per v2 patch",
          "default": false
        },
        "backend": {
          "type": "string",
          "description": "WebGPU first with WebAssembly fallback, or WebAssembly",
          "enum": [
            "auto",
            "wasm"
          ],
          "default": "auto"
        },
        "models": {
          "type": "array",
          "description": "Legacy v1 model seeds; supplying models without a pipeline retains legacy behavior",
          "items": {
            "type": "integer",
            "description": "Model seed",
            "enum": [
              42,
              123,
              456,
              789
            ]
          }
        },
        "threshold": {
          "type": "number",
          "description": "Marker probability threshold",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1
        },
        "markers": {
          "type": "integer",
          "description": "Maximum number of marker components retained",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "model": {
          "type": "string",
          "description": "Weight variant web or fp32; v1 and v2 are pipeline aliases",
          "enum": [
            "web",
            "fp32",
            "v1",
            "v2"
          ]
        }
      },
      "artifacts": {
        "markers": {
          "type": "neuro:mask",
          "mediaType": "application/x-nifti",
          "space": "native",
          "minimum": 1,
          "maximum": 1
        },
        "probability": {
          "type": "neuro:volume",
          "mediaType": "application/x-nifti",
          "space": "native",
          "minimum": 1,
          "maximum": 5
        },
        "detections": {
          "type": "neuro:table",
          "mediaType": "application/json",
          "minimum": 0,
          "maximum": 1
        }
      },
      "engines": [
        "browser"
      ]
    }
  }
}
