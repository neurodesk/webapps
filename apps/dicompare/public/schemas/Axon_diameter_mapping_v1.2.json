      "rules": [
        {
          "id": "custom_1784818252589",
          "name": "Detect low b-value",
          "description": "Detect low b-value for accurate noise mapping",
          "implementation": "thr = params.get(\"max_low_b\") if params.get(\"max_low_b\") is not None else 1100\nerrors = []\nfor i in range(len(value[\"DiffusionBValues\"])):\n    bvals = as_list(value[\"DiffusionBValues\"][i])\n    if len([x for x in bvals if 0 < x < thr]) == 0:\n        errors.append(f\"Entry {i}: no non-zero b-value below {thr:g} s/mm\u00b2 present\")\nif errors:\n    raise ValidationError(chr(10).join(errors))\n",
          "parameters": {
            "max_low_b": 1100
          },
          "fields": [
            "DiffusionBValues"
          ],
          "testCases": [
            {
              "id": "test_noise_pass",
              "name": "Low-b noise scan",
              "data": {
                "DiffusionBValues": [
                  "[0, 500]"
                ]
              },
              "expectedResult": "pass",
              "description": "b=500 shell is suitable for noise estimation."
            },
            {
              "id": "test_noise_fail",
              "name": "High-b only",
              "data": {
                "DiffusionBValues": [
                  "[0, 6000]"
                ]
              },
              "expectedResult": "fail",
              "description": "No low-b shell for noise estimation."
            }
          ],
          "parameterDefinitions": [
            {
              "name": "max_low_b",
              "label": "Low b-value threshold",
              "type": "number",
              "default": 1100,
              "min": 0,
              "unit": "s/mm\u00b2",
              "description": "At least one non-zero b-value below this must be present"
            }
          ]
        }
      ],
      "tags": [
        "analysis:diffusion",
        "brain",
        "noise mapping"
      ]
