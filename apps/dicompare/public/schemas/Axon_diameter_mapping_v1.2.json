      "rules": [
        {
          "id": "custom_1784818594180",
          "name": "Compatible with axon diameter mapping",
          "description": "Evaluates compatibility with axon diameter mapping from Veraart et al. (2020)",
          "implementation": "# Axon diameter mapping needs ultra-strong gradients and multi-shell data.\nfor row in ctx.rows:\n    if float(row[\"MaxDiffGradient\"]) < 250:\n        ctx.error(\"MaxDiffGradient too low for axon diameter mapping (need >= 250 mT/m)\")\n    if float(row[\"NumberOfDiffusionShells\"]) < 2:\n        ctx.error(\"At least two diffusion shells are required for axon diameter mapping\")",
          "fields": [
            "MaxDiffGradient",
            "NumberOfDiffusionShells"
          ],
          "testCases": [
            {
              "id": "test_axon_pass",
              "name": "Connectom axon protocol",
              "data": {
                "MaxDiffGradient": [
                  "280"
                ],
                "NumberOfDiffusionShells": [
                  "2"
                ]
              },
              "expectedResult": "pass",
              "description": "The schema's own protocol: 280 mT/m, 2 shells."
            },
            {
              "id": "test_axon_fail_gradient",
              "name": "Clinical gradient strength",
              "data": {
                "MaxDiffGradient": [
                  "80"
                ],
                "NumberOfDiffusionShells": [
                  "2"
                ]
              },
              "expectedResult": "fail",
              "description": "Standard 80 mT/m gradients cannot resolve axon radii."
            }
          ]
        }
      ]
    },
