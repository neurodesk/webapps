{
  "name": "browserqc",
  "private": true,
  "version": "1.6.20261023",
  "type": "module",
  "license": "BSD-2-Clause",
  "description": "Automated MRI quality control, entirely in the browser. No data leaves your machine.",
  "scripts": {
    "dev": "node scripts/copy-brainchop.mjs && vite --force",
    "build": "node scripts/copy-brainchop.mjs && tsc --noEmit && vite build && node ../../scripts/theme-app-dist.mjs --app browserqc",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && node --experimental-strip-types --test test/*.test.mjs",
    "test:e2e": "node ../../test-utils/run-browser-tests.mjs \"node test/smoke.mjs && playwright test\""
  },
  "dependencies": {
    "@brainchop/mindgrab": "0.1.20260925",
    "@neurodesk/browserqc": "workspace:*",
    "@neurodesk/runtime-support": "workspace:*",
    "@neurodesk/webapp-components": "workspace:*",
    "@niivue/niimath": "1.4.20260928",
    "@niivue/niivue": "1.0.0-rc.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@webgpu/types": "^0.1.52",
    "jsdom": "24.1.3",
    "playwright": "^1.57.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
