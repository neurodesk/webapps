{
  "name": "fastprep",
  "version": "0.2.20261027",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "runtime": "pnpm --filter @neurodesk/greedy build:wasm && pnpm --filter @neurodesk/fastprep build:wasm && node scripts/copy-runtime.mjs",
    "dev": "pnpm run runtime && vite --force",
    "build": "pnpm run runtime && vite build && node ../../scripts/theme-app-dist.mjs --app fastprep",
    "preview": "vite preview",
    "test": "node --test test/*.test.js ../../packages/fastprep/test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "node ../../scripts/lint.mjs --workspace"
  },
  "dependencies": {
    "@brainchop/mindgrab": "0.1.20261008",
    "@neurodesk/fastprep": "workspace:*",
    "@neurodesk/greedy": "workspace:*",
    "@neurodesk/runtime-support": "workspace:*",
    "@neurodesk/synthsr": "workspace:*",
    "@neurodesk/webapp-components": "workspace:*",
    "@niivue/meica": "0.1.20261021",
    "@niivue/niimath": "1.4.20261016",
    "fflate": "^0.8.2",
    "onnxruntime-web": "1.29.0",
    "@neurodesk/sdc": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "esbuild": "0.28.1",
    "vite": "^5.0.0"
  },
  "neurodeskWebapp": {
    "coiServiceWorker": true
  }
}
