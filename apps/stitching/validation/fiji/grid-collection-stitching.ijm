run("Grid/Collection stitching", "type=[Filename defined position] order=[Defined by filename         ] grid_size_x=4 grid_size_y=4 tile_overlap=18 first_file_index_x=1 first_file_index_y=1 directory=/data file_names=img_r{yyy}_c{xxx}.tif output_textfile_name=TileConfiguration.txt fusion_method=[Linear Blending] regression_threshold=0.30 max/avg_displacement_threshold=2.50 absolute_displacement_threshold=3.50 compute_overlap subpixel_accuracy computation_parameters=[Save computation time (but use more RAM)] image_output=[Write to disk] output_directory=/out");
