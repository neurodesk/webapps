# Dependencies
node_modules/

# Build output
dist/
**/dist/
**/target/
.turbo/
playwright-report/
test-results/
apps/*/public/brainchop/
exes/*/dist/
exes/*/models/
exes/*/target/

# Mesh outputs and regression data belong on Hugging Face, not in git
*.stl
*.obj
*.mz3

# dwi2trx ships the small dtifit-enabled niimath runtime, including its WASM.
!apps/dwi2trx/vendor/
!apps/dwi2trx/vendor/niimath/
!apps/dwi2trx/vendor/niimath/dist/
!apps/dwi2trx/vendor/niimath/dist/**

# WASM files (downloaded by per-app setup.sh)
apps/*/web/wasm/

# Vendored shared components (generated from packages/components by each app's vendor script)
apps/*/web/vendor/
apps/qsmbly/vendor/
apps/qsmbly/data/example/
apps/qsmbly/rust-wasm/pkg/
apps/qsmbly/wasm/qsm_wasm*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local audit and planning notes
audit_*.md
plan_*.md
*_plan.md

# Uploaded dataset staging
/reg/

# Temporary model weights
.tmp_weights/
apps/musclemap/.tmp_model_env/
apps/musclemap/.tmp_model_release/
apps/musclemap/web/models/

# Python
__pycache__/
*.pyc
*.egg-info/
apps/*/web/coi-serviceworker.js

# Runtime wrappers generated from packages/runtime-support
apps/*/web/dcm2niix/
apps/*/web/nifti-js/
apps/qsmbly/dcm2niix/
apps/qsmbly/nifti-js/
