# Preserve imported/generated third-party snapshots without treating their
# upstream formatting as a first-party whitespace error.
apps/**/dcm2niix/** whitespace=-trailing-space,-blank-at-eof
apps/qsmbly/niivue/** whitespace=-trailing-space,-blank-at-eof

# These SCT planning assets intentionally use Markdown hard-break whitespace.
apps/spinalcordtoolbox/.agents/** whitespace=-trailing-space,-blank-at-eof
apps/spinalcordtoolbox/.specify/** whitespace=-trailing-space,-blank-at-eof
apps/spinalcordtoolbox/specs/** whitespace=-trailing-space,-blank-at-eof

test-utils/native-nifti/tests/snapshots/*.txt text eol=lf

# Byte-exact native nii2tvx tables: a CRLF checkout on Windows would break every comparison.
exes/nii2tvx/test/*.tsv -text

# LCModel test case inputs and native outputs, compared byte for byte by packages/lcmodel and its release check.
exes/lcmodel/tests/data/** -text

# MuscleMap model contracts are checksum- and byte-size-pinned across platforms.
apps/musclemap/model-sources/*.json -text

# Generated MuscleMap contracts are compared with the generator's exact LF output.
apps/musclemap/web/js/app/model-catalog.generated.js text eol=lf
packages/musclemap/src/model-catalog.generated.js text eol=lf
models/musclemap.manifest.json text eol=lf
