{
  "name": "neurodesk-webapps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && node scripts/build-site.mjs",
    "build:apps": "turbo run build",
    "build:site": "node scripts/build-site.mjs",
    "audit:interfaces": "node scripts/audit-interfaces.mjs",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "audit:convergence": "node scripts/audit-shared-imaging.mjs",
    "generate:mirrors": "node scripts/generate-distribution-mirrors.mjs",
    "test": "node --test test/*.test.mjs && turbo run test",
    "test:contracts": "ls test/*.test.mjs | grep -v -e /runtime-assets.test.mjs -e /easter-egg.test.mjs | xargs node --test",
    "test:packages": "pnpm --filter './packages/*' --filter '!@neurodesk/webapp-components' run test && pnpm --filter @neurodesk/webapp-components run test:unit",
    "test:examples": "node --test test/app-examples.test.mjs",
    "test:registry": "node --test test/registry.test.mjs",
    "app-plan": "node scripts/app-plan.mjs",
    "test:runtime-startup": "node test/runtime-startup.smoke.mjs",
    "test:smoke": "node test/composite-site.smoke.mjs",
    "test:interface-workflows": "node test/interface-workflows.smoke.mjs",
    "test:image-uploads": "node test/image-upload.smoke.mjs",
    "test:mobile": "node test/mobile-layout.smoke.mjs",
    "test:e2e:catalog": "node scripts/run-agentic-tests.mjs",
    "test:e2e:agent": "node scripts/run-agentic-tests.mjs --mode agent",
    "test:e2e:pipeline": "node scripts/run-agentic-tests.mjs --mode pipeline",
    "test:e2e:types": "tsc -p tsconfig.agentic.json",
    "test:deployed": "node test/deployed-site.smoke.mjs",
    "lint": "pnpm lint:correctness && node scripts/lint-workspaces.mjs",
    "new-app": "node scripts/new-app.mjs",
    "release": "node scripts/release-apps.mjs",
    "release:dry-run": "node scripts/release-apps.mjs --dry-run",
    "generate:neuroflow": "node scripts/generate-neuroflow.mjs",
    "test:lint": "node --test test/lint-coverage.test.mjs",
    "lint:correctness": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@changesets/apply-release-plan": "7.1.1",
    "@changesets/cli": "^2.27.0",
    "@changesets/config": "3.1.4",
    "@changesets/get-release-plan": "4.0.16",
    "@e2e-dev/web": "0.11.2",
    "@eslint/js": "9.39.5",
    "@manypkg/get-packages": "1.1.3",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "ai": "7.0.127",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "e2e": "0.16.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "^24.0.0",
    "playwright": "1.64.0",
    "turbo": "^2.0.0",
    "typescript": "7.0.2",
    "yaml": "^2.8.1",
    "zod": "4.6.5",
    "@neurodesk/code-quality": "workspace:*"
  }
}
