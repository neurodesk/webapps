{
  "name": "@neurodesk/synthseg",
  "version": "0.6.20261010",
  "description": "SynthSeg 2.0 brain segmentation for browsers and the command line",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "synthseg": "./bin/synthseg.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./browser": "./src/browser.js",
    "./node": "./src/node.js",
    "./results": "./src/results.js",
    "./manifest": "./model.manifest.json",
    "./wasm": "./src/synthseg.wasm"
  },
  "files": [
    "bin",
    "src",
    "model.manifest.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/*.js && node --check bin/synthseg.js",
    "build:wasm": "make wasm"
  },
  "dependencies": {
    "@neurodesk/webapp-components": "workspace:*",
    "onnxruntime-node": "1.29.0"
  },
  "devDependencies": {
    "@neurodesk/runtime-support": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neurodesk/webapps.git",
    "directory": "packages/synthseg"
  }
}
