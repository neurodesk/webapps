{
  "name": "@neurodesk/sdc",
  "version": "0.3.20261031",
  "description": "Reverse phase-encoding susceptibility distortion correction (PyHySCO port) for browsers and the command line",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later AND Apache-2.0 AND BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/wasm.js",
    "./wasm": "./src/sdc.wasm",
