    "./field-fit.wasm": "./src/sdc-field-fit.wasm"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "LICENSE-SDCFLOW",
    "LICENSE-OPENBLAS"
  ],
