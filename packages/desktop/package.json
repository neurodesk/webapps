{
  "name": "@neurodesk/desktop",
  "version": "0.5.20260915",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "description": "Neurodesk Webapps for local image processing",
  "author": "Neurodesk",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/main.js && node --check src/server.js",
    "start": "electron .",
    "package": "node ../../scripts/desktop/pack.mjs"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.neurodesk.webapps",
    "productName": "Neurodesk Webapps",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "signIgnore": [
        "/Contents/Resources/offline/"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "webapps-${version}-${os}-${arch}.${ext}"
  }
}
