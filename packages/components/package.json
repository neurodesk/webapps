{
  "name": "@neurodesk/webapp-components",
  "version": "0.11.1",
  "description": "Framework-free ESM components for static Neurodesk neuroimaging webapps.",
  "type": "module",
  "types": "./src/index.d.ts",
  "license": "MIT",
  "files": [
    "src",
    "web",
    "templates",
    "docs",
    "index.html",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./core/mount-imaging-workspace": {
      "types": "./src/core/mountImagingWorkspace.d.ts",
      "default": "./src/core/mountImagingWorkspace.js"
    },
    "./ui": {
      "types": "./src/index.d.ts",
      "default": "./src/ui/index.js"
    },
    "./file-io": "./src/file-io/index.js",
    "./file-io/nifti": "./src/file-io/NiftiUtils.js",
    "./file-io/mesh": "./src/file-io/mesh.js",
    "./fetch": {
      "types": "./src/net/fetchWithRetry.d.ts",
      "default": "./src/net/fetchWithRetry.js"
    },
    "./viewer": "./src/viewer/index.js",
    "./inference": "./src/inference/index.js",
    "./pipeline": "./src/pipeline/index.js",
    "./automation": "./src/automation/index.js",
    "./automation/parameters": "./src/automation/parameters.js",
    "./automation/freesurfer-lut": "./src/automation/freesurfer-lut.json",
    "./volume": "./src/volume/index.js",
    "./worker": "./src/worker/index.js",
    "./qsm": "./src/qsm/index.js",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/inference-workspace.css": "./src/styles/inference-workspace.css",
    "./styles/imaging-workspace.css": "./src/styles/imaging-workspace.css",
    "./example-images": "./src/example-images.js",
    "./elements": {
      "types": "./src/elements/index.d.ts",
      "default": "./src/elements/index.js"
    },
    "./elements/console": {
      "types": "./src/elements/console.d.ts",
      "default": "./src/elements/console.js"
    },
    "./elements/file-field": {
      "types": "./src/elements/file-field.d.ts",
      "default": "./src/elements/file-field.js"
    },
    "./elements/result-list": {
      "types": "./src/elements/result-list.d.ts",
      "default": "./src/elements/result-list.js"
    },
    "./elements/viewer-toolbar": {
      "types": "./src/elements/viewer-toolbar.d.ts",
      "default": "./src/elements/viewer-toolbar.js"
    },
    "./elements/mask-editor": {
      "types": "./src/elements/mask-editor.d.ts",
      "default": "./src/elements/mask-editor.js"
    },
    "./elements/example-selector": {
      "types": "./src/elements/example-selector.d.ts",
      "default": "./src/elements/example-selector.js"
    },
    "./compute": {
      "types": "./src/compute/index.d.ts",
      "default": "./src/compute/index.js"
    },
    "./elements/compute-connection": {
      "types": "./src/elements/compute-connection.d.ts",
      "default": "./src/elements/compute-connection.js"
    }
  },
  "scripts": {
    "build:showcase": "node scripts/build-showcase.mjs",
    "serve": "node scripts/serve-showcase.mjs",
    "start": "node scripts/serve-showcase.mjs",
    "test": "node --test test/*.test.js && node scripts/test-showcase-browser.mjs",
    "test:unit": "node --test test/*.test.js",
    "test:showcase:browser": "node scripts/test-showcase-browser.mjs",
    "test:elements:browser": "node scripts/test-elements-browser.mjs",
    "check": "node scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
