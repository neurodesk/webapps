{
  "name": "@neurodesk/syncro",
  "version": "0.9.20261124",
  "type": "module",
  "description": "SYNcro spatial normalization: the shared Rust core's WebAssembly build for the web app, the native command's tool manifest and its release check",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./core": "./wasm/syncro_wasm.js"
  },
  "files": [
    "data",
    "README.md",
    "LICENSE",
    "NOTICE",
    "tools.json",
    "validation/README.md",
    "validation/results",
    "wasm"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:core": "node scripts/build-wasm.mjs && node --test test/core/*.test.js",
    "lint": "node --check validation/package-check.mjs && node --check scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "@neurodesk/brain-extraction": "workspace:*",
    "@neurodesk/greedy": "workspace:*",
    "@neurodesk/registration": "workspace:*",
    "@neurodesk/synthsr": "workspace:*",
    "@neurodesk/synthstrip": "workspace:*",
    "@playwright/test": "1.64.0"
  }
}
