diff --git a/exes/samsrf/core/src/reference.rs b/exes/samsrf/core/src/reference.rs
new file mode 100644
index 0000000..a976150
--- /dev/null
+++ b/exes/samsrf/core/src/reference.rs
@@ -0,0 +1,62 @@
+//! RESEARCH BUILD ONLY (packages/samsrf/validation/matlab/intel-avx512/harness): the MKL
+//! kernels whose rounding differs between MATLAB's recorded hosts, as replaceable hooks.
+//! Unset, every call runs the shipped port's kernels (MKL CNR `auto`, AMD hosts), so a
+//! build of this patch that installs nothing computes what the shipped module computes.
+//! The harness's WebAssembly crate installs the test-only `samsrf-mkl-avx512` kernels
+//! (MKL's AVX512_E1 branch on the recorded Intel hosts) for real double data only:
+//! `x' * y` from 51 elements, `norm`, `y' * A` and the least-squares chain. Single and
+//! complex kernels are not replaced; no recording identifies their Intel arithmetic.
+
+use std::sync::OnceLock;
+
+/// A real double design factored by one reference's `?geqp3`. Unwind-safe like the port's
+/// own factorisation, so a `DoubleDesign` stays usable across `catch_unwind`.
+pub trait RealDesign: std::panic::RefUnwindSafe + std::panic::UnwindSafe {
+    /// Coefficients in column order and `Q' y` of right-hand side `index` of `count`.
+    fn solve_with_qty(&self, y: &[f64], count: usize, index: usize) -> (Vec<f64>, Vec<f64>);
+    fn rank(&self) -> usize;
+    /// The design column in each pivoted position.
+    fn pivot(&self) -> &[usize];
+    /// Packed columns in pivoted order: R on and above the diagonal, reflectors below.
+    fn packed(&self) -> &[Vec<f64>];
+    fn taus(&self) -> &[f64];
+}
+
+/// One reference's real double kernels.
+pub struct Kernels {
+    pub name: &'static str,
+    /// MATLAB's real `x' * y`, from `matlab_math::DDOT_MKL_MIN_LENGTH` elements (MKL `ddot`).
+    pub ddot: fn(&[f64], &[f64]) -> f64,
+    /// MATLAB's `norm` of a real double vector (MKL `dnrm2`).
+    pub dnrm2: fn(&[f64]) -> f64,
+    /// MATLAB's double `y' * A` (MKL `dgemv` with `trans`), one value per column.
+    pub gemv_t: fn(&[f64], &[&[f64]]) -> Vec<f64>,
+    /// `?geqp3` of a finite real double design with at least one row.
+    pub factor: fn(&[&[f64]]) -> Box<dyn RealDesign>,
+}
+
+static ACTIVE: OnceLock<Kernels> = OnceLock::new();
+
+/// Installs a reference's kernels for the life of the module; a second install panics.
+pub fn install(kernels: Kernels) {
+    if ACTIVE.set(kernels).is_err() {
+        panic!("a reference is already installed");
+    }
+}
+
+pub fn active() -> Option<&'static Kernels> {
+    ACTIVE.get()
+}
+
+/// The installed reference's name, or the shipped port's.
+pub fn name() -> &'static str {
+    active().map_or("shipped (MKL CNR auto)", |kernels| kernels.name)
+}
+
+/// `norm` of a real double vector in the installed reference, else the shipped `nrm2`.
+pub fn dnrm2(values: &[f64]) -> f64 {
+    match active() {
+        Some(kernels) => (kernels.dnrm2)(values),
+        None => crate::matlab_math::nrm2(values.iter().copied()),
+    }
+}
