+/// RESEARCH BUILD ONLY: a `samsrf_mkl_avx512::Design` as the core's reference design.
+struct IntelDesign(samsrf_mkl_avx512::Design);
+
+impl samsrf_core::reference::RealDesign for IntelDesign {
+    fn solve_with_qty(&self, y: &[f64], count: usize, index: usize) -> (Vec<f64>, Vec<f64>) {
+        self.0.solve_with_qty(y, count, index)
+    }
+    fn rank(&self) -> usize {
+        self.0.rank()
+    }
+    fn pivot(&self) -> &[usize] {
+        self.0.pivot()
+    }
+    fn packed(&self) -> &[Vec<f64>] {
+        self.0.packed()
+    }
+    fn taus(&self) -> &[f64] {
+        self.0.taus()
+    }
+}
+
+static INSTALL: std::sync::Once = std::sync::Once::new();
+
+/// RESEARCH BUILD ONLY: installs the test-only reference for MKL's AVX512_E1 branch (the
+/// recorded Intel hosts) for real double data, once; native research tests call this first.
+pub fn install_research_reference() {
+    INSTALL.call_once(|| {
+        samsrf_core::reference::install(samsrf_core::reference::Kernels {
+            name: "MKL AVX512_E1 research reference (samsrf-mkl-avx512): real double ddot from 51, dnrm2 candidate, y'*A, least squares",
+            ddot: samsrf_mkl_avx512::blas::ddot,
+            dnrm2: samsrf_mkl_avx512::nrm2,
+            gemv_t: samsrf_mkl_avx512::blas::gemv_t,
+            factor: |columns| Box::new(IntelDesign(samsrf_mkl_avx512::Design::new(columns))),
+        });
+    });
+}
+
+/// RESEARCH BUILD ONLY: the module installs the reference when it is instantiated.
+#[wasm_bindgen(start)]
+fn start() {
+    install_research_reference();
+}
 
