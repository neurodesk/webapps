+fn solve_complex_reference(kernels: &crate::reference::Kernels, columns: &[&[Complex64]], ys: &[&[f64]], keep_qty: bool) -> Solved {
+    let design = (kernels.complex_factor)(columns);
+    let (mut coefficients, mut qty) = (Vec::new(), Vec::new());
+    for (index, y) in ys.iter().enumerate() {
+        let (x, q) = design.solve(y, ys.len(), index);
+        coefficients.push(x);
+        qty.push(if keep_qty { q } else { Vec::new() });
+    }
+    let packed = design.packed().to_vec();
+    let r = (0..2).map(|i| (0..2).map(|j| if j < i { Complex64::new(0.0, 0.0) } else { packed[j][i] }).collect()).collect();
+    Solved { coefficients, qty, rank: design.rank(), pivot: design.pivot().to_vec(),
+        r, packed, tau: design.tau().to_vec() }
+}
