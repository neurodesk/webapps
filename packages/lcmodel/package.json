{
  "name": "@neurodesk/lcmodel",
  "version": "0.6.20261010",
  "description": "FID-A preprocessing and LCModel fitting of MR spectroscopy for browsers and the command line (Rust ports compiled to WebAssembly)",
  "type": "module",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lcmodel": "./bin/lcmodel.js"
  },
  "exports": {
    ".": "./src/wasm.js",
    "./wasm": "./src/lcmodel.wasm",
    "./pipeline": "./src/pipeline.js",
    "./basis-select": "./src/basis-select.js",
    "./group": "./src/group.js",
    "./inputs": "./src/inputs.js",
    "./lcmodel-io": "./src/lcmodel-io.js",
    "./library": "./src/library.js",
    "./report": "./src/report.js",
    "./spectrum-plot": "./src/spectrum-plot.js",
    "./tissue": "./src/tissue.js",
    "./node": "./src/node.js",
    "./manifest": "./model.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "model.manifest.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node --check src/*.js && node --check bin/lcmodel.js",
    "build:wasm": "make wasm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neurodesk/webapps.git",
    "directory": "packages/lcmodel"
  }
}
