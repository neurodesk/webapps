{
  "name": "freebrowse",
  "version": "2.5.0-next.1",
  "description": "FreeBrowse: an embeddable neuroimaging viewer UI on top of NiiVue",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freesurfer/freebrowse.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/freesurfer/freebrowse#readme",
  "bugs": {
    "url": "https://github.com/freesurfer/freebrowse/issues"
  },
  "keywords": [
    "niivue",
    "neuroimaging",
    "viewer",
    "freesurfer",
    "nifti"
  ],
  "files": [
    "dist-lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist-lib/types/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./react": {
      "types": "./dist-lib/types/react.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@niivue/niivue": "1.0.0-rc.17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@niivue/nv-ext-drawing": "1.0.0-rc.16",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@tailwindcss/vite": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "zustand": "^5.0.11"
  },
  "freebrowseSource": {
    "repository": "https://github.com/pwighton/freebrowse.git",
    "branch": "20260929-niivue-mono-fixes-merged",
    "commit": "eae80a127fdd99974c80952e890bf18aa6e9d5dd",
    "niivue": "1.0.0-rc.17"
  }
}
