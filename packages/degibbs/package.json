{
  "name": "@neurodesk/degibbs",
  "version": "0.3.20261023",
  "description": "Gibbs-ringing removal (MRtrix mrdegibbs port) for browsers and the command line",
  "type": "module",
  "private": true,
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "degibbs": "./bin/degibbs.js"
  },
  "exports": {
    ".": "./src/wasm.js",
    "./wasm": "./src/degibbs.wasm",
    "./outputs": "./src/outputs.js",
    "./node": "./src/node.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm": "bash scripts/build-wasm.sh --check",
    "test": "node --test test/*.test.js",
    "lint": "node --check src/wasm.js && node --check src/outputs.js && node --check src/node.js && node --check bin/degibbs.js"
  },
  "dependencies": {
    "@neurodesk/webapp-components": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neurodesk/webapps.git",
    "directory": "packages/degibbs"
  }
}
